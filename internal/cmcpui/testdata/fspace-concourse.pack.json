       },
       {
        "widget": "button",
        "props": {
         "text": "FULL",
         "tone": "accent",
         "key": "v"
        },
        "on": {
         "click": {
          "cmd": "world.view",
          "args": {
           "mode": "normal"
          }
         }
        }
       }
      ]
     },
     {
      "widget": "textport",
      "id": "text",
